<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_neu"
    android:gravity="center"
    android:padding="32dp">

    <!-- Icon Lock -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_lock"
        android:contentDescription="@string/app_lock_title"
        app:tint="@color/accent_neu"
        android:layout_marginBottom="24dp" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_lock_title"
        android:textColor="@color/text_primary_neu"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle (dynamically set) -->
    <TextView
        android:id="@+id/lockSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary_neu"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- PIN Section (initially hidden) -->
    <LinearLayout
        android:id="@+id/pinSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/pinInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Masukkan PIN"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:gravity="center"
            android:textColor="@color/text_primary_neu"
            android:textColorHint="@color/text_secondary_neu"
            android:background="@drawable/bg_neumorphic_inset"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pinConfirmButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/confirm"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_neumorphic_button_accent"
            app:backgroundTint="@null" />

    </LinearLayout>

</LinearLayout>
