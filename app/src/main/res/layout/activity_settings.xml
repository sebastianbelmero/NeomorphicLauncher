<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout Settings Activity.
    Settings Activity layout.

    Berisi:
      - Header dengan back button & title
      - Section: Theme Mode (Light/Dark/Auto)
      - Section: Accent Color (5 preset warna)
      - Section: Background Color (jika mode = Light)
      - Section: Corner Radius Slider
      - Section: Shadow Intensity Slider
      - Save button
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_neu"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_neumorphic_inset"
            android:paddingHorizontal="16dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/back"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/text_secondary_neu" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="@string/settings_title"
                android:textColor="@color/text_primary_neu"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Section: Theme Mode -->
        <LinearLayout
            android:id="@+id/themeModeSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_neumorphic_card"
            android:padding="20dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_theme_mode"
                android:textColor="@color/text_primary_neu"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/themeModeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_light"
                    android:textColor="@color/text_primary_neu"
                    android:paddingVertical="8dp"
                    android:buttonTint="@color/accent_neu" />

                <RadioButton
                    android:id="@+id/radio_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_dark"
                    android:textColor="@color/text_primary_neu"
                    android:paddingVertical="8dp"
                    android:buttonTint="@color/accent_neu" />

                <RadioButton
                    android:id="@+id/radio_auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_auto"
                    android:textColor="@color/text_primary_neu"
                    android:paddingVertical="8dp"
                    android:buttonTint="@color/accent_neu" />

            </RadioGroup>

        </LinearLayout>

        <!-- Section: Accent Color -->
        <LinearLayout
            android:id="@+id/accentColorSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_neumorphic_card"
            android:padding="20dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/themeModeSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_accent_color"
                android:textColor="@color/text_primary_neu"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <View
                    android:id="@+id/colorPurple"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/circle_purple"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:id="@+id/colorBlue"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/circle_blue"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:id="@+id/colorPink"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/circle_pink"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:id="@+id/colorGreen"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/circle_green"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:id="@+id/colorOrange"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/circle_orange"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- Section: Background Color (only shown when theme is Light) -->
        <LinearLayout
            android:id="@+id/backgroundColorSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_neumorphic_card"
            android:padding="20dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/accentColorSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_background_color"
                android:textColor="@color/text_primary_neu"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_background_color_hint"
                android:textColor="@color/text_secondary_neu"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Section: Corner Radius -->
        <LinearLayout
            android:id="@+id/cornerRadiusSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_neumorphic_card"
            android:padding="20dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/backgroundColorSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_corner_radius"
                    android:textColor="@color/text_primary_neu"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cornerRadiusValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_neu"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="24 dp" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/cornerRadiusSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Section: Shadow Intensity -->
        <LinearLayout
            android:id="@+id/shadowIntensitySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_neumorphic_card"
            android:padding="20dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/cornerRadiusSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_shadow_intensity"
                    android:textColor="@color/text_primary_neu"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/shadowIntensityValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_neu"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="70%" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/shadowIntensitySlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/save"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_neumorphic_button_accent"
            app:backgroundTint="@null"
            android:layout_marginHorizontal="4dp"
            app:layout_constraintTop_toBottomOf="@id/shadowIntensitySection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
