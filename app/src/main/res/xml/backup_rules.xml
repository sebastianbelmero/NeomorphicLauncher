<?xml version="1.0" encoding="utf-8"?>
<!--
    Aturan backup data — Data backup rules.
    Konfigurasi backup untuk Android 12+ (API 31+).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="neumorphic_launcher_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="neumorphic_launcher_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
