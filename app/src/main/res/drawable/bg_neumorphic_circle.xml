<?xml version="1.0" encoding="utf-8"?>
<!--
    Background Neumorphic bulat (untuk dock icons).
    Circular Neumorphic background (for dock icons).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="@color/shadow_dark_neu" />
        </shape>
    </item>

    <item android:left="1dp" android:top="1dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/shadow_light_neu" />
        </shape>
    </item>

    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/background_neu" />
        </shape>
    </item>

</layer-list>
