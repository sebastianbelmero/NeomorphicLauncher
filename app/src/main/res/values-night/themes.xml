<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Tema dark mode — Mengikuti AppCompatDelegate.MODE_NIGHT_YES.
        Dark mode theme.
    -->
    <style name="Theme.NeumorphicLauncher" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/background_neu</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="colorPrimary">@color/accent_neu</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/accent_neu</item>
    </style>

    <style name="Theme.NeumorphicLauncher.Home" parent="Theme.NeumorphicLauncher">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.NeumorphicLauncher.Drawer" parent="Theme.NeumorphicLauncher">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="Theme.NeumorphicLauncher.Settings" parent="Theme.NeumorphicLauncher">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

</resources>
